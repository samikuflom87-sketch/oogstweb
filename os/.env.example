# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# Zonder deze variabelen draait Oogstweb OS volledig in demo-modus:
# alle gegevens blijven lokaal in de browser (localStorage) en de
# AI-adviseur toont duidelijk dat hij niet verbonden is.

# --- Supabase (database + authenticatie) ---
# Project-instellingen > API in je Supabase-project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (AI-adviseur en agents) ---
# console.anthropic.com > API Keys. Blijft server-side, wordt nooit
# naar de browser gestuurd.
ANTHROPIC_API_KEY=

# Optioneel: override het modelnaam als Anthropic een nieuwer model
# uitbrengt. Controleer de actuele model-ID's op
# https://docs.claude.com/en/docs/about-claude/models voordat je dit instelt.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
